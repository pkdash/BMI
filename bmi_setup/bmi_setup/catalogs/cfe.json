    "soil_params.expon_secondary": {
      "dtype": "float64",
      "length": 1,
      "config_key": "soil_params.expon_secondary",
      "set_value": "none"
    },
    "gw_storage": {
      "dtype": "float64",
      "length": 1,
      "units": "m/m",
      "config_key": "gw_storage",
      "set_value": "none",
      "note": "initial groundwater storage, fraction of max_gw_storage"
    },
    "soil_storage": {
      "dtype": "float64",
      "length": 1,
      "units": "m/m",
      "config_key": "soil_storage",
      "set_value": "none",
      "note": "initial soil storage, fraction of capacity"
    },
    "giuh_ordinates": {
      "dtype": "float64",
      "length": null,
      "config_key": "giuh_ordinates",
      "set_value": "none"
    }
  }
}
