{
  "model": "cfe",
  "codec": "KeyValueConfig",
  "library": "NOAA-OWP/cfe src/bmi_cfe.c (param_var_names)",
  "parameters": {
    "a_Xinanjiang_inflection_point_parameter": {
      "dtype": "float64",
      "length": 1,
      "config_key": "a_Xinanjiang_inflection_point_parameter",
      "set_value": "equivalent",
      "note": "read from the config only when surface_partitioning_scheme=Xinanjiang"
    },
    "alpha_fc": {
      "dtype": "float64",
      "length": 1,
      "config_key": "alpha_fc",
      "set_value": "equivalent"
    },
    "b": {
      "dtype": "float64",
      "length": 1,
      "config_key": "soil_params.b",
      "set_value": "equivalent"
    },
    "b_Xinanjiang_shape_parameter": {
      "dtype": "float64",
      "length": 1,
      "config_key": "b_Xinanjiang_shape_parameter",
      "set_value": "unexercised",
      "note": "read from the config only when surface_partitioning_scheme=Xinanjiang"
    },
    "Cgw": {
      "dtype": "float64",
      "length": 1,
      "units": "m h-1",
      "config_key": "Cgw",
      "set_value": "equivalent"
    },
    "expon": {
      "dtype": "float64",
      "length": 1,
      "config_key": "expon",
      "set_value": "equivalent"
    },
    "Kinf_nash_surface": {
      "dtype": "float64",
      "length": 1,
      "units": "h-1",
      "config_key": "Kinf_nash_surface",
      "set_value": "equivalent",
      "note": "used only when surface_runoff_scheme=NASH_CASCADE"
    },
    "Klf": {
      "dtype": "float64",
      "length": 1,
      "config_key": "K_lf",
      "set_value": "unexercised"
