    "refkdt": {
      "dtype": "float64",
      "length": 1,
      "config_key": "refkdt",
      "set_value": "equivalent"
    },
    "retention_depth_nash_surface": {
      "dtype": "float64",
      "length": 1,
      "units": "m",
      "config_key": "retention_depth_nash_surface",
      "set_value": "equivalent",
      "note": "used only when surface_runoff_scheme=NASH_CASCADE"
    },
    "satdk": {
      "dtype": "float64",
      "length": 1,
      "units": "m s-1",
      "config_key": "soil_params.satdk",
      "set_value": "equivalent"
    },
    "satpsi": {
      "dtype": "float64",
      "length": 1,
      "units": "m",
      "config_key": "soil_params.satpsi",
      "set_value": "equivalent"
    },
    "slope": {
      "dtype": "float64",
      "length": 1,
      "units": "m/m",
      "config_key": "soil_params.slop",
      "set_value": "unexercised"
    },
    "wltsmc": {
      "dtype": "float64",
      "length": 1,
      "units": "m/m",
      "config_key": "soil_params.wltsmc",
      "set_value": "equivalent"
    },
    "x_Xinanjiang_shape_parameter": {
      "dtype": "float64",
      "length": 1,
      "config_key": "x_Xinanjiang_shape_parameter",
      "set_value": "equivalent",
      "note": "read from the config only when surface_partitioning_scheme=Xinanjiang"
    },
    "soil_params.depth": {
      "dtype": "float64",
      "length": 1,
      "units": "m",
      "config_key": "soil_params.depth",
      "set_value": "none"
    },
    "soil_params.expon": {
      "dtype": "float64",
      "length": 1,
      "config_key": "soil_params.expon",
      "set_value": "none",
